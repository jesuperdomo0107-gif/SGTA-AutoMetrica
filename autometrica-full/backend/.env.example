# ==============================================================================
# CONFIGURACIÓN GENERAL - AUTOMETRICA BACKEND (DESARROLLO Y PRODUCCIÓN RENDER)
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=postgresql://postgres:1234@localhost:5432/autometrica_db

# Seguridad y CORS (En producción Render, coloca tu dominio de frontend y backend)
JWT_SECRET_KEY=cambia_esta_clave_secreta_por_una_larga_y_aleatoria
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Credenciales del Superusuario inicial (usadas automáticamente por build.sh)
SUPERUSER_EMAIL=admin@autometrica.com
SUPERUSER_PASSWORD=AdminSegura2026!
SUPERUSER_NAME=Administrador Principal

# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (GMAIL SMTP / RESEND)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AutoMétrica Soporte
SMTP_FROM_EMAIL=

RESEND_API_KEY=
RESEND_FROM=AutoMétrica <onboarding@resend.dev>

# ==============================================================================
# CONFIGURACIÓN DE SMS (TWILIO - OPCIONAL)
